# CCE Insights Service — Environment Variables
# Copy to .env and adjust values for your environment.

# Server
SERVER_PORT=8084

# Database (ClickHouse — shared cce_analytics database)
DB_HOST=localhost
DB_PORT=8123
DB_NAME=cce_analytics
DB_USERNAME=cce_pipeline
DB_PASSWORD=cce_analytics_dev
DB_POOL_SIZE=10

# Spring profile (local | docker | test)
SPRING_PROFILES_ACTIVE=local
